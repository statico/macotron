<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Macotron</string>
    <key>CFBundleIdentifier</key>
    <string>io.statico.macotron</string>
    <key>CFBundleVersion</key>
    <string>1.0</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>Macotron</string>
    <key>CFBundleIconFile</key>
    <string>Macotron</string>
    <key>CFBundleIconName</key>
    <string>Macotron</string>
    <key>LSUIElement</key>
    <true/>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>io.statico.macotron.url</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>macotron</string>
                <string>http</string>
                <string>https</string>
                <string>mailto</string>
            </array>
        </dict>
    </array>
    <!-- Being the default http/https handler makes Macotron the system browser,
         and macOS then hands it .html files too. Claim them so Launch Services
         doesn't refuse with "cannot open files in the HTML text format"; the
         open lands in application(_:open:) and routes like any other link. -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Web Page</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.html</string>
                <string>public.xhtml</string>
            </array>
        </dict>
    </array>
    <key>NSAppleEventsUsageDescription</key>
    <string>Macotron plugins can control other apps through Apple events.</string>
    <key>NSFocusStatusUsageDescription</key>
    <string>Plugins can see when a Focus mode is on.</string>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>Macotron plugins can list upcoming calendar events.</string>
    <key>NSRemindersFullAccessUsageDescription</key>
    <string>Macotron plugins can list and complete reminders.</string>
    <key>NSHomeKitUsageDescription</key>
    <string>Macotron plugins can list and control HomeKit accessories.</string>
    <key>NSContactsUsageDescription</key>
    <string>Macotron plugins can search and list contacts.</string>
    <key>NSScreenCaptureUsageDescription</key>
    <string>Macotron plugins can capture the screen to read it, pick a region, or scan a QR code.</string>
    <key>NSCameraUsageDescription</key>
    <string>Macotron plugins can scan QR codes with the camera.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Macotron plugins can record audio.</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Macotron plugins can read the Bluetooth radio, list paired devices, and turn Bluetooth on or off.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Macotron plugins can find Apple TVs and other devices on your local network.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_companion-link._tcp</string>
        <string>_airplay._tcp</string>
    </array>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright 2026. All rights reserved.</string>
    <!-- Sparkle self-updates. The feed is site/appcast.xml in this repo, which
         Vercel serves at the domain root. The public key's other half lives in
         the login keychain of the Mac that runs `make release`. -->
    <key>SUFeedURL</key>
    <string>https://macotron.statico.io/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>5EsMP78hecRMzlBFPezwdT5YlzP1OKifKlWGeE6X1KM=</string>
    <!-- Check daily without asking first. Without this Sparkle interrupts the
         first launch to ask whether it may check at all. -->
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <!-- Check the signature before mounting. Sparkle otherwise hands an
         unverified disk image to hdiutil, so a hijacked feed would get the
         kernel to parse an attacker's file before anything rejects it. -->
    <key>SUVerifyUpdateBeforeExtraction</key>
    <true/>
</dict>
</plist>
